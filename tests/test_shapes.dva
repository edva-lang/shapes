// shapes/tests/test_shapes.dva — Test suite for 3D shapes library
#use io
#use "math/geom"
#use "../src/shapes"
#use color
#use "../src/vertex"
#use "../src/polyhedra"

#foreign "c"
   malloc: (size: Int) => Addr
   free: (ptr: Addr) => ()

approx_eq = a, b => %abs(a - b) < 0.0001
assert_flag = msg, f =>
   f
      | io::out("PASS: " + msg)
      | io::out("FAIL: " + msg)

main: () => ()
main = !=>
   // 1. Color and Hex Tests
   c_hex = shapes::color_hex(0xFF8000)
   assert_flag("hex red ~ 1.0", approx_eq(c_hex.r, 1.0))
   assert_flag("hex green ~ 0.5019", approx_eq(c_hex.g, 128.0 / 255.0))
   assert_flag("hex blue ~ 0.0", approx_eq(c_hex.b, 0.0))

   // 2. Uniform & Glass Color Providers
   u_fn = shapes::uniform(color::emerald)
   c0 = u_fn(0)
   c15 = u_fn(15)
   assert_flag("uniform c0 == c15", approx_eq(c0.r, c15.r) && approx_eq(c0.g, c15.g) && approx_eq(c0.b, c15.b) && approx_eq(c0.a, 1.0))

   g_fn = shapes::glass(shapes::rainbow, 0.5)
   cg0 = g_fn(0)
   assert_flag("glass alpha == 0.5", approx_eq(cg0.a, 0.5) && approx_eq(cg0.r, color::red.r))

   // 3. Normal Vector Calculation (via std/math/geom)
   p0 = geom::vec3(0.0, 0.0, 0.0)
   p1 = geom::vec3(1.0, 0.0, 0.0)
   p2 = geom::vec3(0.0, 1.0, 0.0)
   norm = geom::normal3(p0, p1, p2)
   assert_flag("normal3 +Z normal", approx_eq(norm.x, 0.0) && approx_eq(norm.y, 0.0) && approx_eq(norm.z, 1.0))

   // 4. Polyhedra Builders
   buf = malloc(512 * shapes::VERTEX_STRIDE)

   // Tetrahedron
   k1 = shapes::write_tetrahedron(buf, 0, 2.0, shapes::tetrahedron_default)
   assert_flag("tetrahedron vertex count", k1 == shapes::TETRAHEDRON_VERTICES)

   // Cube
   k2 = shapes::write_cube(buf, 0, 2.0, shapes::cube_default)
   assert_flag("cube vertex count", k2 == shapes::CUBE_VERTICES)

   // Octahedron
   k3 = shapes::write_octahedron(buf, 0, 2.0, shapes::octahedron_default)
   assert_flag("octahedron vertex count", k3 == shapes::OCTAHEDRON_VERTICES)

   // Dodecahedron
   k4 = shapes::write_dodecahedron(buf, 0, 2.0, shapes::dodecahedron_default)
   assert_flag("dodecahedron vertex count", k4 == shapes::DODECAHEDRON_VERTICES)

   // Icosahedron
   k5 = shapes::write_icosahedron(buf, 0, 2.0, shapes::icosahedron_default)
   assert_flag("icosahedron vertex count", k5 == shapes::ICOSAHEDRON_VERTICES)

   // Plane
   k6 = shapes::write_plane(buf, 0, 5.0, 5.0, color::slate)
   assert_flag("plane vertex count", k6 == shapes::PLANE_VERTICES)

   free(buf)

   // 5. Curved Parametric Shapes
   buf_curved = malloc(4096 * shapes::VERTEX_STRIDE)

   // UV Sphere
   v_sphere = shapes::sphere_vertex_count(12, 24)
   assert_flag("sphere vertex count formula", v_sphere == shapes::SPHERE_DEFAULT_VERTICES)
   k_sph = shapes::write_sphere_default(buf_curved, 0, 1.5, shapes::curved_default)
   assert_flag("write_sphere_default count", k_sph == shapes::SPHERE_DEFAULT_VERTICES)

   // Cylinder
   v_cyl = shapes::cylinder_vertex_count(24, <+>)
   assert_flag("cylinder vertex count formula", v_cyl == shapes::CYLINDER_DEFAULT_VERTICES)
   k_cyl = shapes::write_cylinder_default(buf_curved, 0, 1.0, 2.5, shapes::curved_default)
   assert_flag("write_cylinder_default count", k_cyl == shapes::CYLINDER_DEFAULT_VERTICES)

   // Cone
   v_cone = shapes::cone_vertex_count(24, <+>)
   assert_flag("cone vertex count formula", v_cone == shapes::CONE_DEFAULT_VERTICES)
   k_cone = shapes::write_cone_default(buf_curved, 0, 1.0, 2.0, shapes::curved_default)
   assert_flag("write_cone_default count", k_cone == shapes::CONE_DEFAULT_VERTICES)

   // Torus
   v_torus = shapes::torus_vertex_count(16, 24)
   assert_flag("torus vertex count formula", v_torus == shapes::TORUS_DEFAULT_VERTICES)
   k_torus = shapes::write_torus_default(buf_curved, 0, 1.8, 0.5, shapes::curved_default)
   assert_flag("write_torus_default count", k_torus == shapes::TORUS_DEFAULT_VERTICES)

   // Filament (3D Curve with Polar Cross-Section r = f(angle, dist))
   pts = shapes::Point{}
   pts += shapes::pt(0.0, 0.0, 0.0)
   pts += shapes::pt(0.5, 1.0, 0.2)
   pts += shapes::pt(1.2, 1.5, -0.4)
   pts += shapes::pt(2.0, 0.5, 0.8)

   v_fil_cap = shapes::filament_vertex_count(4, 24, <+>)
   assert_flag("filament capped vertex count formula", v_fil_cap == 4 * 24 * 6)
   v_fil_uncap = shapes::filament_vertex_count(4, 24, <->)
   assert_flag("filament uncapped vertex count formula", v_fil_uncap == 3 * 24 * 6)

   polar_fn = angle, dist => 0.15 * (1.0 + (0.25 * %cos(5.0 * angle + dist)))
   fil_col_fn = angle, dist => color::lerp(color::sapphire, color::emerald, dist / 3.0)
   k_fil_cap = shapes::write_filament_default(buf_curved, 0, <+ pts ->, polar_fn, fil_col_fn)
   assert_flag("write_filament_default (points) count", k_fil_cap == v_fil_cap)
   curve_fn = u => shapes::vec3(%cos(u * 3.14), u * 2.0, %sin(u * 3.14))
   k_fil_curve = shapes::write_filament(buf_curved, 0, <- curve_fn +>, 4, shapes::const_radius(0.15), 24, <->, fil_col_fn)
   assert_flag("write_filament (curve fn) count", k_fil_curve == v_fil_uncap)

   free(buf_curved)
   io::out("All shapes tests completed successfully.")

main!
