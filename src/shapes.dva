// shapes/src/shapes.dva — Public library API for 3D procedural shapes & polyhedra

#use "math/geom"
#use color
#use "vertex"
#use "polyhedra"
#use "curved"

#public

// Core Record Types
#type Point geom::Vec3
#type Vec3  geom::Vec3
#type Vertex vertex::Vertex
#type Mesh   vertex::Mesh
#type FilamentSpine curved::FilamentSpine

// Vertex Layout Constants & Mesh Slice Helper
VERTEX_STRIDE = vertex::VERTEX_STRIDE

vertex_buffer: Int => Builder
vertex_buffer = max_vertices => vertex::vertex_buffer(max_vertices)

mesh: Int, Int => vertex::Mesh
mesh = start, end_idx => vertex::mesh(start, end_idx)

// Vertex Counts for Platonic Solids and Planar Helpers
TETRAHEDRON_VERTICES  = 12
CUBE_VERTICES         = 36
OCTAHEDRON_VERTICES   = 24
DODECAHEDRON_VERTICES = 108
ICOSAHEDRON_VERTICES  = 60
PLANE_VERTICES        = 6
STAR_VERTICES         = 12

// Default Vertex Counts for Curved Parametric Shapes
SPHERE_DEFAULT_VERTICES    = curved::SPHERE_DEFAULT_VERTICES
ICOSPHERE_DEFAULT_VERTICES = curved::ICOSPHERE_DEFAULT_VERTICES
CYLINDER_DEFAULT_VERTICES  = curved::CYLINDER_DEFAULT_VERTICES
CONE_DEFAULT_VERTICES      = curved::CONE_DEFAULT_VERTICES
TORUS_DEFAULT_VERTICES     = curved::TORUS_DEFAULT_VERTICES

// 3D Point / Vector Constructors
pt: Float, Float, Float => geom::Vec3
pt = x, y, z => geom::vec3(x, y, z)

vec3: Float, Float, Float => geom::Vec3
vec3 = x, y, z => geom::vec3(x, y, z)

// Curved Parametric Vertex Count Calculators
sphere_vertex_count: Int, Int => Int
sphere_vertex_count = r, s => curved::sphere_vertex_count(r, s)

icosphere_vertex_count: Int => Int
icosphere_vertex_count = subdivs => curved::icosphere_vertex_count(subdivs)

cylinder_vertex_count: Int, <> => Int
cylinder_vertex_count = s, c => curved::cylinder_vertex_count(s, c)

cone_vertex_count: Int, <> => Int
cone_vertex_count = s, c => curved::cone_vertex_count(s, c)

torus_vertex_count: Int, Int => Int
torus_vertex_count = r, t => curved::torus_vertex_count(r, t)

filament_vertex_count: Int, Int, <> => Int
filament_vertex_count = n_pts, segs, cap => curved::filament_vertex_count(n_pts, segs, cap)

// Curved Parametric Shape Builders (Flexible Resolution)
write_sphere: Builder, Int, Float, Int, Int, (Int => color::Color) => Int
write_sphere = buf, idx, rad, rings, secs, col => curved::write_sphere(buf, idx, rad, rings, secs, col)

write_icosphere: Builder, Int, Float, Int, (Int => color::Color) => Int
write_icosphere = buf, idx, rad, subdivs, col => curved::write_icosphere(buf, idx, rad, subdivs, col)

write_cylinder: Builder, Int, Float, Float, Int, <>, (Int => color::Color) => Int
write_cylinder = buf, idx, rad, h, segs, cap, col => curved::write_cylinder(buf, idx, rad, h, segs, cap, col)

write_cone: Builder, Int, Float, Float, Int, <>, (Int => color::Color) => Int
write_cone = buf, idx, rad, h, segs, cap, col => curved::write_cone(buf, idx, rad, h, segs, cap, col)

write_torus: Builder, Int, Float, Float, Int, Int, (Int => color::Color) => Int
write_torus = buf, idx, r_maj, r_min, rad, tub, col => curved::write_torus(buf, idx, r_maj, r_min, rad, tub, col)

const_radius: Float => (Float, Float => Float)
const_radius = r => curved::const_radius(r)

spine_points: geom::Vec3{} => curved::FilamentSpine
spine_points = pts => curved::spine_points(pts)

spine_curve: (Float => geom::Vec3) => curved::FilamentSpine
spine_curve = fn => curved::spine_curve(fn)

write_filament: Builder, Int, curved::FilamentSpine, Int, (Float, Float => Float), Int, <>, (Float, Float => color::Color) => Int
write_filament = buf, idx, spine, num_pts, rad_fn, segs, cap, col => curved::write_filament(buf, idx, spine, num_pts, rad_fn, segs, cap, col)

// Curved Parametric Shape Builders (Default Presets)
write_sphere_default: Builder, Int, Float, (Int => color::Color) => Int
write_sphere_default = buf, idx, rad, col => curved::write_sphere_default(buf, idx, rad, col)

write_icosphere_default: Builder, Int, Float, (Int => color::Color) => Int
write_icosphere_default = buf, idx, rad, col => curved::write_icosphere_default(buf, idx, rad, col)

write_cylinder_default: Builder, Int, Float, Float, (Int => color::Color) => Int
write_cylinder_default = buf, idx, rad, h, col => curved::write_cylinder_default(buf, idx, rad, h, col)

write_cone_default: Builder, Int, Float, Float, (Int => color::Color) => Int
write_cone_default = buf, idx, rad, h, col => curved::write_cone_default(buf, idx, rad, h, col)

write_torus_default: Builder, Int, Float, Float, (Int => color::Color) => Int
write_torus_default = buf, idx, r_maj, r_min, col => curved::write_torus_default(buf, idx, r_maj, r_min, col)

write_filament_default: Builder, Int, curved::FilamentSpine, (Float, Float => Float), (Float, Float => color::Color) => Int
write_filament_default = buf, idx, spine, rad_fn, col => curved::write_filament_default(buf, idx, spine, rad_fn, col)

// Uniform Geometry Builders
write_tetrahedron: Builder, Int, Float, (Int => color::Color) => Int
write_tetrahedron = buf, idx, s, c => polyhedra::write_tetrahedron(buf, idx, s, c)

write_cube: Builder, Int, Float, (Int => color::Color) => Int
write_cube = buf, idx, s, c => polyhedra::write_cube(buf, idx, s, c)

write_octahedron: Builder, Int, Float, (Int => color::Color) => Int
write_octahedron = buf, idx, s, c => polyhedra::write_octahedron(buf, idx, s, c)

write_icosahedron: Builder, Int, Float, (Int => color::Color) => Int
write_icosahedron = buf, idx, s, c => polyhedra::write_icosahedron(buf, idx, s, c)

write_dodecahedron: Builder, Int, Float, (Int => color::Color) => Int
write_dodecahedron = buf, idx, s, c => polyhedra::write_dodecahedron(buf, idx, s, c)

// Planar Builders
write_plane: Builder, Int, Float, Float, color::Color => Int
write_plane = buf, idx, w, h, col => polyhedra::write_plane(buf, idx, w, h, col)

write_star_base: Builder, Int, color::Color, color::Color => Int
write_star_base = buf, idx, c1, c2 => polyhedra::write_star_base(buf, idx, c1, c2)
