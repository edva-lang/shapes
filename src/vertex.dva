// shapes/src/vertex.dva — Packed 3D GPU Vertex buffer layout and writer (12 floats: pos3, rgba4, norm3, uv2)

#public

// Structured packed record for GPU 3D vertex data (12 floats: pos3, rgba4, norm3, uv2)
#type Vertex #packed (
   px: f32,
   py: f32,
   pz: f32,
   cr: f32,
   cg: f32,
   cb: f32,
   ca: f32,
   nx: f32,
   ny: f32,
   nz: f32,
   u:  f32,
   v:  f32
)

VERTEX_STRIDE = 48        // 12 floats * 4 bytes

// Packed vertex constructor with explicit UV coordinates (pos3 + rgba4 + norm3 + uv2)
vertex_uv: Float, Float, Float, Float, Float, Float, Float, Float, Float, Float, Float, Float => Vertex
vertex_uv = px, py, pz, cr, cg, cb, ca, nx, ny, nz, u, v =>
   Vertex(f32(px), f32(py), f32(pz), f32(cr), f32(cg), f32(cb), f32(ca), f32(nx), f32(ny), f32(nz), f32(u), f32(v))

// Packed vertex constructor with default (0, 0) UV coordinates
vertex: Float, Float, Float, Float, Float, Float, Float, Float, Float, Float => Vertex
vertex = px, py, pz, cr, cg, cb, ca, nx, ny, nz =>
   Vertex(f32(px), f32(py), f32(pz), f32(cr), f32(cg), f32(cb), f32(ca), f32(nx), f32(ny), f32(nz), f32(0.0), f32(0.0))

// Allocate a vertex staging Builder with capacity for `max_vertices` vertices
vertex_buffer: Int => Builder
vertex_buffer = max_vertices =>
   {max_vertices * VERTEX_STRIDE}

// Write a packed vertex record directly into memory at vertex index `idx`
write_vertex: Builder, Int, Vertex => ()
write_vertex = buf, idx, v =>
   %memcpy(&buf + (idx * VERTEX_STRIDE), &v, #size Vertex)

// Drawable slice within a GPU vertex buffer (first vertex index + vertex count)
#type Mesh (start: Int, count: Int)

mesh: Int, Int => Mesh
mesh = start, end_idx =>
   Mesh(start, end_idx - start)
